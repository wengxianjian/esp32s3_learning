menu "DNESP32S3 Learning Demo"

choice DEMO_RESOURCE
    prompt "Select resource demo to run"
    default DEMO_LED

config DEMO_LED
    bool "LED (GPIO output)"

config DEMO_KEY
    bool "KEY (GPIO input, press BOOT to toggle LED)"

config DEMO_EXIT
    bool "EXIT (GPIO external interrupt, press BOOT to toggle LED)"
endchoice

endmenu
